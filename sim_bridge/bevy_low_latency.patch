+        );
+        let pose = app.world().get::<GlobalTransform>(muzzle).unwrap();
+        let expected = (INITIAL_LOOK_AT - pose.translation()).normalize();
+        assert!((pose.rotation() * Vec3::Y - expected).length() < 1e-5);
