+        }
+        app.update();
+        assert_eq!(
+            app.world().get::<Transform>(root).unwrap().translation,
+            ROBOT_POSITION
+        );
+        assert_eq!(app.world().get::<Position>(root).unwrap().0, ROBOT_POSITION);
+        assert_eq!(
+            *app.world().get::<RigidBody>(root).unwrap(),
+            RigidBody::Static
+        );
+        assert_eq!(
+            app.world().get::<LinearVelocity>(root).unwrap().0,
