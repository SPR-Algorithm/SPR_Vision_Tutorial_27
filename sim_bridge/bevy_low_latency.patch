+// Bound the entire asynchronous readback + conversion + publication pipeline.
+// Explicit dataset submissions retain their completeness semantics.
+const MAX_REALTIME_READBACKS: usize = 3;
+
+struct ReadbackPermit(Arc<AtomicUsize>);
+
+impl ReadbackPermit {
+    fn acquire(count: &Arc<AtomicUsize>, realtime: bool) -> Option<Self> {
+        count
+            .fetch_update(Ordering::AcqRel, Ordering::Acquire, |n| {
+                if realtime && n >= MAX_REALTIME_READBACKS {
+                    None
+                } else {
+                    Some(n + 1)
+                }
+            })
+            .ok()?;
+        Some(Self(count.clone()))
+    }
+}
+
+impl Drop for ReadbackPermit {
+    fn drop(&mut self) {
+        self.0.fetch_sub(1, Ordering::AcqRel);
+    }
+}
